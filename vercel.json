{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/arcade",
      "destination": "/arcade/index.html"
    },
    {
      "source": "/arcade/",
      "destination": "/arcade/index.html"
    },
    {
      "source": "/arcade/(.+)",
      "destination": "/arcade/game.html"
    }
  ]
}